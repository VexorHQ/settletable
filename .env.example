# Salin ke .env dan isi seiring build. JANGAN commit file .env.
# Nilai di sini cuma placeholder/contoh — bukan kunci atau alamat asli.

# RPC HSK Chain (default sudah benar; isi hanya bila pakai node sendiri)
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_MAINNET_RPC=https://mainnet.hsk.xyz

# HSP — isi SETELAH dokumen HSP didapat (lihat RESEARCH.md §3)
HSP_API_URL=
HSP_API_KEY=

# Alamat kontrak — isi SETELAH deploy (27 Nov testnet, 1 Des mainnet)
# Token settlement testnet: USDC HSP (sudah terverifikasi on-chain 25 Nov).
# MockUSDC hanya cadangan — alamatnya diisi deploy-testnet bila dipakai.
PAYMENT_TOKEN_ADDRESS_TESTNET=0x8FE3cB719Ee4410E236Cd6b72ab1fCDC06eF53c6
PAYMENT_TOKEN_ADDRESS_MAINNET=0x84fA0c5a2E8CEb4C5BfA8E9fB5F2aA93f3fA6a39
RECEIPT_REGISTRY_TESTNET=
RECEIPT_REGISTRY_MAINNET=

# Wallet deploy + wallet demo (testnet saja).
# JANGAN isi dengan kunci wallet asli/mainnet di file ini.
DEPLOYER_PRIVATE_KEY=
BUYER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
